@page "/Profile"
@model SecureClicker.Pages.ProfileModel

<h1>Profile</h1>

<p>Clicks: <span id="clickCount">@Model.Clicks</span></p>

<button type="button" id="clickButton">
    Click!
</button>

@Html.AntiForgeryToken()

<script>
    let clicks = @Model.Clicks;
    let unsavedClicks = 0;

    const button = document.getElementById("clickButton");
    const clickCount = document.getElementById("clickCount");
    const token = document.querySelector(
        'input[name="__RequestVerificationToken"]'
    ).value;

    // Clicking only changes the local JavaScript state
    button.addEventListener("click", () => {
        clicks++;
        unsavedClicks++;

        clickCount.textContent = clicks;
    });

    // Save accumulated clicks every 15 seconds
    setInterval(async () => {
        if (unsavedClicks === 0) {
            return;
        }

        const clicksToSave = unsavedClicks;

        const response = await fetch("?handler=SaveClicks", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "RequestVerificationToken": token
            },
            body: JSON.stringify({
                clicks: clicksToSave
            })
        });

        if (!response.ok) {
            console.error("Failed to save clicks.");
            return;
        }

        const data = await response.json();

        // Only reset after the server successfully saved them
        unsavedClicks = 0;
        clicks = data.clicks;

        clickCount.textContent = clicks;

    }, 15000);
</script>

<form method="post" asp-page="/Authentication/Logout">
    <button type="submit">Logout</button>
</form>